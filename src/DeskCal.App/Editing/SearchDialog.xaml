<Window x:Class="DeskCal.App.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskCal.App"
        Title="DeskCal" Width="468" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:HexBrushConverter x:Key="HexBrush" />

        <!-- 결과 한 줄 (Figma Result): 날짜·시간 | 카테고리 선(할 일은 원) | 제목·설명 -->
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="8" Padding="8,7" Margin="0,0,0,2" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ToggleTrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource DdayChipBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource BaseText}" FontSize="10" FontWeight="Medium"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource BaseText}" FontSize="9" Margin="0,1,0,0"
                               Foreground="{DynamicResource MutedBrush}" Visibility="{Binding TimeVisibility}" />
                </StackPanel>
                <Border Grid.Column="1" Width="3" Height="24" CornerRadius="1.5" Margin="0,0,10,0"
                        Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" Visibility="{Binding BarVisibility}" />
                <Ellipse Grid.Column="1" Width="12" Height="12" Margin="0,0,10,0" StrokeThickness="1.5"
                         Stroke="{DynamicResource CheckboxBorderBrush}" Visibility="{Binding CircleVisibility}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" TextDecorations="{Binding Decorations}" />
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource BaseText}" FontSize="9" Margin="0,1,0,0"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 24px 바깥 여백은 그림자 자리 -->
    <Border Margin="24" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderThickness="1"
            BorderBrush="{DynamicResource ControlBorderBrush}" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <!-- 검색 입력 (Figma Search input) -->
            <DockPanel Margin="16,13,14,13">
                <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleX="1.142857" ScaleY="1.142857" />
                    </Canvas.RenderTransform>
                    <Path Data="{StaticResource SearchCircleIcon}" Stroke="{DynamicResource SubtleBrush}" StrokeThickness="1.16667" />
                    <Path Data="{StaticResource SearchHandleIcon}" Stroke="{DynamicResource SubtleBrush}" StrokeThickness="1.16667"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                        Background="{DynamicResource ToggleTrackBrush}">
                    <TextBlock Text="Esc" Style="{StaticResource BaseText}" FontSize="9" Foreground="{DynamicResource SubtleBrush}" />
                </Border>
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="일정·할 일 검색 (제목·메모)" Style="{StaticResource BaseText}" FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBox x:Name="QueryBox" FontFamily="{StaticResource AppFont}" FontSize="13" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                             VerticalContentAlignment="Center" TextChanged="OnQueryChanged" />
                </Grid>
            </DockPanel>

            <!-- 결과 (Figma Results) -->
            <Border x:Name="ResultsPanel" BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <StackPanel Margin="8,10,8,6">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                        <TextBlock Text="검색 결과" Style="{StaticResource BaseText}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SubtleBrush}" />
                        <TextBlock x:Name="CountText" Style="{StaticResource BaseText}" FontSize="10" FontWeight="Bold" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyText" Text="찾는 항목이 없습니다." Style="{StaticResource BaseText}" FontSize="11" Margin="8,8,0,10"
                               Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />
                    <ListBox x:Name="ResultList" MaxHeight="210" Background="Transparent" BorderThickness="0" Focusable="False"
                             ItemContainerStyle="{StaticResource ResultItem}" ItemTemplate="{StaticResource ResultTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="OnResultMouseDown" MouseDoubleClick="OnResultDoubleClick" />
                </StackPanel>
            </Border>

            <!-- 조작 안내 (Figma Hint) -->
            <Border BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <TextBlock Text="↑↓ 고르기 · Enter 그 날짜로 이동 · Esc 닫기" Style="{StaticResource BaseText}" FontSize="9"
                           Foreground="{DynamicResource MutedBrush}" />
            </Border>
        </StackPanel>
    </Border>
</Window>
