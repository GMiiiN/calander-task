<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 설계 §6.1 토큰 (Figma 기준). 색은 Colors.Light.xaml / Colors.Dark.xaml에 있다. -->
    <FontFamily x:Key="AppFont">Noto Sans KR, Malgun Gothic</FontFamily>

    <DropShadowEffect x:Key="CardShadow" Color="#263359" Opacity="0.12" BlurRadius="24" ShadowDepth="4" Direction="270" />

    <!-- Figma 아이콘(Assets) 경로를 그대로 옮긴 것 -->
    <Geometry x:Key="ChevronLeftIcon">M10 12L6 8L10 4</Geometry>
    <Geometry x:Key="ChevronRightIcon">M6 12L10 8L6 4</Geometry>
    <Geometry x:Key="PlusIcon">M6 2V6M6 6V10M6 6H2M6 6H10</Geometry>
    <Geometry x:Key="CheckIcon">M2 5.2L4.1 7.2L8 3</Geometry>
    <Geometry x:Key="SearchCircleIcon">M10.5 6.41667C10.5 8.67183 8.67183 10.5 6.41667 10.5C4.1615 10.5 2.33333 8.67183 2.33333 6.41667C2.33333 4.1615 4.1615 2.33333 6.41667 2.33333C8.67183 2.33333 10.5 4.1615 10.5 6.41667Z</Geometry>
    <Geometry x:Key="SearchHandleIcon">M11.6667 11.6667L9.625 9.625</Geometry>
    <Geometry x:Key="EllipsisIcon">M9.20826 8.5C9.20826 8.89151 8.89116 9.2089 8.5 9.2089C8.10884 9.2089 7.79174 8.89151 7.79174 8.5C7.79174 8.10849 8.10884 7.7911 8.5 7.7911C8.89116 7.7911 9.20826 8.10849 9.20826 8.5ZM14.1661 8.5C14.1661 8.89151 13.849 9.2089 13.4578 9.2089C13.0667 9.2089 12.7496 8.89151 12.7496 8.5C12.7496 8.10849 13.0667 7.7911 13.4578 7.7911C13.849 7.7911 14.1661 8.10849 14.1661 8.5ZM4.25042 8.5C4.25042 8.89151 3.93333 9.2089 3.54216 9.2089C3.151 9.2089 2.8339 8.89151 2.8339 8.5C2.8339 8.10849 3.151 7.7911 3.54216 7.7911C3.93333 7.7911 4.25042 8.10849 4.25042 8.5Z</Geometry>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 투명 배경 버튼: 테두리 모양은 Content 쪽 Border가 정한다 -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 사이드바 체크박스: 14px 원, 체크 시 강조색 + 흰 체크 -->
    <Style x:Key="RoundCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="14" Height="14" CornerRadius="7" BorderThickness="1.2"
                            Background="{DynamicResource CheckboxFillBrush}" BorderBrush="{DynamicResource CheckboxBorderBrush}">
                        <Path x:Name="Mark" Data="{StaticResource CheckIcon}" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="10" Stretch="None" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 입력란: 옅은 바탕 + 둥근 모서리 (Figma Title field / Date / Time). 편집 창·설정 창 -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="8" BorderThickness="1" Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 창 아래 알약 버튼(삭제·취소·저장). 편집 창·설정 창 -->
    <Style x:Key="FooterButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="99" Padding="14,5" BorderThickness="1" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource BaseText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
