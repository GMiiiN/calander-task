<Window x:Class="DeskCal.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCal Spike" Width="940" Height="607" MinWidth="808" MinHeight="528"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Noto Sans KR, Malgun Gothic">
    <Window.Resources>
        <!-- 조정 모드에서만 보이는 크기 조절 손잡이: 투명한 영역 + 커서 -->
        <Style x:Key="Grip" TargetType="Thumb">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 그림자 여백 24px 포함: 카드 892 x 559, 최소 760 x 480 (설계 §3.3) -->
    <Grid Margin="24">
        <Border x:Name="Card" CornerRadius="20" BorderThickness="1"
                BorderBrush="#99FFFFFF" Background="#EDFFFFFF"
                MouseLeftButtonDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#263359" Opacity="0.12" BlurRadius="24" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="2026년" FontSize="11" FontWeight="Medium" Foreground="#56677D"/>
                    <TextBlock Text="10월" FontSize="22" FontWeight="Bold" Foreground="#25364A"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StateText" FontSize="28" FontWeight="Bold" Foreground="#246BDE" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SizeText" FontSize="11" Foreground="#56677D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AdjustButton" Content="크기·위치 조정" Click="OnToggleAdjust" Margin="0,0,8,0" Padding="12,4"/>
                    <Button Content="투명도 전환" Click="OnToggleOpacity" Margin="0,0,8,0" Padding="12,4"/>
                    <Button Content="편집 팝업 열기" Click="OnOpenEditor" Margin="0,0,8,0" Padding="12,4"/>
                    <Button Content="종료" Click="OnClose" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 조정 모드 표시: 강조 테두리 + 안내 -->
        <Border x:Name="AdjustOverlay" CornerRadius="20" BorderThickness="2" BorderBrush="#246BDE"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                    Background="#246BDE" CornerRadius="99" Padding="12,4">
                <TextBlock Text="조정 중 · 가장자리를 끌어 크기, 안쪽을 끌어 위치 변경" FontSize="11" Foreground="White"/>
            </Border>
        </Border>
        <!-- 가장자리 10px 손잡이 (카드 안쪽) -->
        <Thumb Style="{StaticResource Grip}" Tag="L"  Width="10" HorizontalAlignment="Left"  Margin="0,10" Cursor="SizeWE" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="R"  Width="10" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWE" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="T"  Height="10" VerticalAlignment="Top"    Margin="10,0" Cursor="SizeNS" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="B"  Height="10" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNS" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="TL" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="TR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="BL" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="OnGripDrag"/>
        <Thumb Style="{StaticResource Grip}" Tag="BR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnGripDrag"/>
    </Grid>
</Window>
